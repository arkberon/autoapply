{
  "name": "autoapply",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "vite build && node --import tsx server/index.ts",
    "dev": "concurrently -k -n api,web \"node --watch --import tsx server/index.ts\" \"vite\"",
    "import": "node --import tsx server/import.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.13.13",
    "playwright-core": "^1.64.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
